  app.post("/api/chat", requireAuth, async (req, res) => {
    try {
      const { message, courseContext } = req.body;
      const { GoogleGenAI } = await import('@google/genai');
      
      const ai = new GoogleGenAI({
        apiKey: process.env.GEMINI_API_KEY,
        httpOptions: {
