        return {
          ...result,
          feedback: feedbacks[i % feedbacks.length],
          trend: trends[i % trends.length],
          points: result.grade === 'A' ? 4.0 : result.grade === 'B' ? 3.0 : result.grade === 'C' ? 2.0 : 1.0
