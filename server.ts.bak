      }).from(clinicRecords)
      .leftJoin(st, eq(clinicRecords.studentId, st.id))
      .leftJoin(dr, eq(clinicRecords.staffId, dr.id))
      .where(isNotNull(clinicRecords.prescription))
      .orderBy(desc(clinicRecords.visitDate));
      
