      const { db } = await import('./src/db');
      const { eq } = await import('drizzle-orm');

      const studentPayments = await db.select().from(payments).where(eq(payments.studentId, userId));
      const totalPaid = studentPayments
        .filter(p => p.status === 'successful')
        .reduce((sum, p) => sum + p.amount, 0);
      
      const EXPECTED_TOTAL_FEES = 250000; // Mock total fees
      const balance = Math.max(EXPECTED_TOTAL_FEES - totalPaid, 0);

      res.json({ totalExpected: EXPECTED_TOTAL_FEES, totalPaid, balance });
    } catch (e) {
